# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API (copy these from your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
# Public site URL (used for email verification redirects + referral links).
# In production use your real domain, e.g. https://pakprofithub.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
